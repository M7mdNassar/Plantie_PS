<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android 12+ splash screen -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Solid background colour (white) – no logo -->
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <!-- Remove the animated icon (no icon) -->
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <!-- Keep the background drawable as fallback -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>